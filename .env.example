# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   cp .env.example .env
# ห้าม commit ไฟล์ .env ขึ้น Git

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laptopdb
DB_USER=root
DB_PASSWORD=your_password_here

# --- Flask ---
# ตั้งเป็น 1 เฉพาะตอนพัฒนาเท่านั้น
FLASK_DEBUG=1
# เปลี่ยนพอร์ตได้หากพอร์ต 5000 ถูกใช้งานอยู่ (เช่น Windows บางเครื่องจองพอร์ตนี้ไว้)
PORT=5000

# --- EmailJS (ฟอร์มติดต่อในหน้าแรก ปล่อยว่างได้ถ้าไม่ใช้) ---
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
